# =========================
# HOME MANAGER
# =========================
if [ -e "/etc/profiles/per-user/$USER/etc/profile.d/hm-session-vars.sh" ]; then
  . "/etc/profiles/per-user/$USER/etc/profile.d/hm-session-vars.sh"
fi


# =========================
# SSH AGENT (stable socket)
# =========================
export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"

# Fix broken socket
if [ -e "$SSH_AUTH_SOCK" ] && [ ! -S "$SSH_AUTH_SOCK" ]; then
  rm -f "$SSH_AUTH_SOCK"
fi

# Start agent if needed
if [ ! -S "$SSH_AUTH_SOCK" ] || ! ssh-add -l >/dev/null 2>&1; then
  rm -f "$SSH_AUTH_SOCK" 2>/dev/null
  eval "$(ssh-agent -a "$SSH_AUTH_SOCK" -s)" >/dev/null
fi

# Load Git/SSH key only if this exact key is missing from the agent.
# The previous ED25519 check was too broad because other ED25519 keys may be loaded.
SSH_MAIN_KEY="$HOME/.ssh/id_ed25519_touchid"
SSH_MAIN_KEY_FINGERPRINT="$(ssh-keygen -lf "$SSH_MAIN_KEY.pub" -E sha256 2>/dev/null | awk '{print $2}')"

if [ -n "$SSH_MAIN_KEY_FINGERPRINT" ] && ! ssh-add -l -E sha256 2>/dev/null | grep -q "$SSH_MAIN_KEY_FINGERPRINT"; then
  ssh-add --apple-use-keychain -t 8h "$SSH_MAIN_KEY" 2>/dev/null || ssh-add -t 8h "$SSH_MAIN_KEY"
fi


# =========================
# HOMEBREW (base system)
# =========================
# sets PATH, MANPATH, etc cleanly
eval "$(/opt/homebrew/bin/brew shellenv)"


# =========================
# VOLTA (must override brew node)
# =========================
export VOLTA_HOME="$HOME/.volta"
export PATH="$VOLTA_HOME/bin:$PATH"

# =========================
# LOCAL / USER BINARIES
# =========================
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"


# =========================
# .NET
# =========================
export DOTNET_ROOT="$HOME/.dotnet"
export PATH="$DOTNET_ROOT:$PATH"
export DOTNET_MULTILEVEL_LOOKUP=0


# =========================
# TEX
# =========================
export PATH="/Library/TeX/texbin:$PATH"


# =========================
# NIX (darwin / daemon)
# =========================
if [ -e /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
  . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi
