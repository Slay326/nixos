#!/usr/bin/env bash

set -euo pipefail

LIGHT_BLUE='\033[1;34m'
NO_COLOR='\033[0m'

print () {
    echo -e "${LIGHT_BLUE}$1${NO_COLOR}"
}

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
host="${NIXOS_CONFIG:-$(hostname)}"

cd "$repo_root"

print "=> Starting installation for $host"

print "==> Formatting Code"
alejandra .

print "==> Rebuilding NixOS"
sudo nixos-rebuild switch --upgrade --verbose --flake ".#$host" "$@"
